[Unit]
Description=Howdy Authentication D-Bus Daemon
After=dbus.service
Requires=dbus.service
Before=display-manager.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=dbus
BusName=@authentication_bus@
ExecStart=@authentication_exec@

User=root
Group=root

Restart=on-failure
TimeoutStartSec=60
RestartSec=1

StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes

ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectHome=yes
ProtectClock=yes

RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

UMask=0077
LockPersonality=yes

ReadWritePaths=@openvino_cache_dir@

CapabilityBoundingSet=
AmbientCapabilities=

PrivateTmp=yes
PrivateIPC=yes
PrivateNetwork=yes
IPAddressDeny=any

ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RemoveIPC=yes

LimitCORE=0

[Install]
WantedBy=multi-user.target
