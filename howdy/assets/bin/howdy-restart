#!/bin/bash

# One call for each service: with a unit that does not exist systemctl does nothing with the others of
# the same call. fprintd is not installed everywhere, it is left alone then.
has_fprintd() {
    systemctl cat fprintd.service > /dev/null 2>&1
}

case "$1" in
    pre)
        # Both at the same time, and waited for: the computer goes to sleep when they are stopped
        has_fprintd && systemctl stop fprintd.service &
        systemctl stop @howdy_authentication_service_name@ &
        wait
        ;;
    post)
        # Restart the daemons without waiting for them. Howdy takes a few seconds
        # (it loads its models first) and blocking here would hold the wakeup, and
        # with it the frozen user sessions, until it is done. The PAM module waits
        # for the daemon to come back instead.
        has_fprintd && systemctl --no-block restart fprintd.service
        systemctl --no-block restart @howdy_authentication_service_name@
        ;;
esac

exit 0
