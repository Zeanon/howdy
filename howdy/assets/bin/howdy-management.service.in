[Unit]
Description=Howdy Authentication D-Bus Daemon
After=dbus.service
Requires=dbus.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=dbus
BusName=@management_bus@
# The daemon says that it is stopping before it gives up its name after a while without requests
NotifyAccess=main
ExecStart=@management_exec@

User=root

Restart=on-failure
RestartSec=1

StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes

ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectHome=yes
ProtectClock=yes

RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

UMask=0077
LockPersonality=yes

# Where the face models are kept
@models_directory_setting@

# The key of the face model encryption, sealed to the TPM (empty without the option)
@models_key_setting@

CapabilityBoundingSet=
AmbientCapabilities=

PrivateTmp=yes
PrivateIPC=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any

ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RemoveIPC=yes

MemoryDenyWriteExecute=yes
LimitCORE=0

[Install]
WantedBy=multi-user.target
