#!/bin/bash
# No global "set -e": every menu action runs in its own subshell with "set -e"
# (see run_action), so a failing command ends the action and not the manager.
# This is a template, meson sets the path of the config file (see meson.build).

CONFIG_FILE="@config_file_path@"

# ----------------------------
# Helpers
# ----------------------------
pause() {
    read -rp "Press Enter to continue..."
}

error_exit() {
    echo
    echo "❌ ERROR: $1"
    exit 1
}

# For the actions that change the system or /etc/howdy. Calls of howdy for the
# face models need no root, they are authorized by polkit.
require_root() {
    if [[ $EUID -ne 0 ]]; then
        error_exit "This action needs root privileges, start the manager with sudo"
    fi
}

# ----------------------------
# Polkit
# ----------------------------
POLKIT_ACTION="@management_interface@"

# Managing face models needs the polkit action of the Howdy management daemon.
# Ask for it once, the authorization is retained for a short time and covers the
# calls of howdy below. Does nothing for root, without polkit or as long as the
# action is not installed (Howdy is not installed yet).
authorize() {
    [[ $EUID -eq 0 ]] && return 0
    command -v pkcheck >/dev/null || return 0
    pkaction --action-id "$POLKIT_ACTION" >/dev/null 2>&1 || return 0

    pkcheck --action-id "$POLKIT_ACTION" --process "$$" --allow-user-interaction || {
        echo "⚠️  Authorization denied, commands that need it will fail"
        return 1
    }
}

# Run a menu action in a subshell with "set -e". A failing command (also of
# howdy, for example if the polkit authorization is denied) or an error_exit ends
# only the action. The message stays on the screen, the menu is drawn below it.
KEEP_OUTPUT=0
run_action() {
    local rc
    # Not in a "||" list, bash ignores "set -e" there
    ( set -e; "$@" )
    rc=$?
    if [[ $rc -ne 0 ]]; then
        echo
        echo "⚠️  The action failed (exit code $rc)"
        KEEP_OUTPUT=1
    fi
    return 0
}

# ----------------------------
# Detect OS
# ----------------------------
detect_os() {
    if [[ -f /etc/os-release ]]; then
        . /etc/os-release
        DISTRO="$ID"
        VERSION="$VERSION_ID"
    else
        read -rp "Enter distro (ubuntu/fedora/debian/arch): " DISTRO
        read -rp "Enter version: " VERSION
    fi

    DISTRO="$(echo "$DISTRO" | tr 'A-Z' 'a-z')"
    echo "Installing dependencies..."
    apt update
    apt install -y \
        software-properties-common \
        v4l-utils \
        python3-opencv \
        python3-numpy \
        libpam-python \
        libinireader0
}

# ----------------------------
# Install Howdy
# ----------------------------
install_howdy() {
    require_root
    detect_os

    echo
    echo "Detected: $DISTRO $VERSION"
    echo

    case "$DISTRO" in
        ubuntu|linuxmint)
            MAJOR="${VERSION%%.*}"

            if [[ "$MAJOR" -ge 24 ]]; then
                echo "⚠️ Ubuntu $VERSION detected"
                echo "Using UbuntuHandbook PPA (community-maintained)"
                pause

                apt update
                apt install -y software-properties-common v4l-utils
                add-apt-repository -y ppa:ubuntuhandbook1/howdy
                apt update
                apt install -y howdy
            else
                echo "Using official Howdy PPA"
                apt update
                apt install -y software-properties-common v4l-utils
                add-apt-repository -y ppa:boltgolt/howdy
                apt update
                apt install -y howdy
            fi
            ;;

        fedora)
            echo "Installing Howdy via Fedora COPR"
            dnf copr enable -y principis/howdy
            dnf --refresh install -y howdy v4l-utils
            ;;

        debian)
            echo
            echo "Debian detected."
            echo "Download .deb from:"
            echo "https://github.com/boltgolt/howdy/releases"
            echo
            echo "Then install with:"
            echo "sudo apt install gdebi"
            echo "sudo gdebi howdy_x.y.z_amd64.deb"
            pause
            return
            ;;

        arch)
            echo
            echo "Arch Linux detected."
            echo "Install Howdy from AUR:"
            echo "yay -S howdy"
            echo "or"
            echo "paru -S howdy"
            pause
            return
            ;;

        *)
            error_exit "Unsupported distro: $DISTRO"
            ;;
    esac

    command -v howdy >/dev/null || error_exit "Howdy installation failed"
    echo "✅ Howdy installed successfully"
    authorize || true
    pause
}

# ----------------------------
# Camera configuration
# ----------------------------
configure_camera() {
    require_root

    echo
    echo "Available cameras:"
    v4l2-ctl --list-devices || error_exit "v4l-utils not installed"

    echo
    read -rp "Enter camera device (example: /dev/video0): " DEVICE

    [[ ! -e "$DEVICE" ]] && error_exit "Device not found"

    sed -i "s|^device_path *=.*|device_path = $DEVICE|" "$CONFIG_FILE"

    echo "✅ Camera set to $DEVICE"
    pause
}

# ----------------------------
# Menu actions
# ----------------------------
add_face() {
    echo
    echo "📸 Adding face model"
    echo "Look at the camera. Press Ctrl+C to cancel."
    pause
    howdy add
}

test_face() {
    echo
    echo "🧪 Testing face recognition"
    pause
    howdy test
}

list_models() {
    echo
    howdy list
    pause
}

remove_model() {
    howdy list
    echo
    read -rp "Enter model ID (or 'all'): " ID

    if [[ "$ID" == "all" ]]; then
        howdy clear
    else
        howdy remove "$ID"
    fi
    pause
}

toggle_howdy() {
    echo
    echo "1) Disable Howdy completely"
    echo "2) Disable Howdy for login screen only"
    echo "3) Enable Howdy (restore defaults)"
    echo
    read -rp "Choose: " CHOICE

    case "$CHOICE" in
        1)
            require_root
            howdy disable
            ;;
        2)
            require_root
            howdy disable-login
            ;;
        3)
            echo
            echo "To enable Howdy again, edit the config:"
            echo "sudo howdy config"
            echo
            echo "Set:"
            echo "disabled = false"
            echo "disable_login = false"
            ;;
        *)
            echo "Invalid choice"
            ;;
    esac
    pause
}

config_menu() {
    echo
    echo "========== HOWDY CONFIG =========="
    echo "1) Set camera device"
    echo "E) Enable Howdy"
    echo "D) Disable Howdy"
    echo "L) Disable login screen only"
    echo "T) Set timeout"
    echo "S) Set certainty (security level)"
    echo "C) Show current config"
    echo "B) Back"
    echo
    read -rp "Choose option: " CFG

    case "$CFG" in
        1)
            configure_camera
            ;;
        E|e)
            require_root
            set_config disabled false
            set_config disable_login false
            echo "Howdy enabled"
            ;;
        D|d)
            require_root
            set_config disabled true
            echo "Howdy disabled"
            ;;
        L|l)
            require_root
            set_config disable_login true
            echo "Login screen disabled"
            ;;
        T|t)
            require_root
            read -rp "Enter timeout (seconds): " T
            set_config timeout "$T"
            ;;
        S|s)
            require_root
            read -rp "Enter certainty (higher = stricter, e.g. 4.5): " C
            set_config certainty "$C"
            ;;
        C|c)
            echo
            cat "$CONFIG_FILE"
            ;;
        B|b)
            return
            ;;
        *)
            echo "Invalid option"
            ;;
    esac
    pause
}

set_config() {
    KEY="$1"
    VALUE="$2"
    CONFIG="$CONFIG_FILE"

    if grep -q "^$KEY" "$CONFIG"; then
        sed -i "s|^$KEY *=.*|$KEY = $VALUE|" "$CONFIG"
    else
        echo "$KEY = $VALUE" >> "$CONFIG"
    fi
}



# ----------------------------
# Main Menu
# ----------------------------
main_menu() {
    if [[ $KEEP_OUTPUT -eq 1 ]]; then
        KEEP_OUTPUT=0
        echo
    else
        clear
    fi
    echo "======================================"
    echo "     HOWDY FACE AUTH MANAGER (BASH)"
    echo "======================================"
    echo
    echo "I) Install Howdy"
    echo "A) Add face model"
    echo "T) Test face recognition"
    echo "L) List face models"
    echo "D) Remove / clear models"
    echo "E) Enable / disable Howdy"
    echo "C) Configure Howdy"
    echo "Q) Exit"
    echo
    read -rp "Choose an option: " CHOICE

    case "$CHOICE" in
        I|i) run_action install_howdy ;;
        A|a) run_action add_face ;;
        T|t) run_action test_face ;;
        L|l) run_action list_models ;;
        D|d) run_action remove_model ;;
        E|e) run_action toggle_howdy ;;
        C|c) run_action config_menu ;;
        Q|q) exit 0 ;;
        *) echo "Invalid choice"; pause ;;
    esac
}

# ----------------------------
# Entry point
# ----------------------------
# require_root
# authorize

while true; do
    main_menu
done

