#!/bin/bash
# No global "set -e": every menu action runs in its own subshell with "set -e"
# (see run_action), so a failing command ends the action and not the manager.
# This is a template, meson sets the path of the config file (see meson.build).

CONFIG_FILE="@config_file_path@"

# ----------------------------
# Helpers
# ----------------------------
pause() {
    read -rp "Press Enter to continue..."
}

error_exit() {
    echo
    echo "❌ ERROR: $1"
    exit 1
}

# For the actions that change the system or /etc/howdy. Calls of howdy for the
# face models need no root, they are authorized by polkit.
require_root() {
    if [[ $EUID -ne 0 ]]; then
        error_exit "This action needs root privileges, start the manager with sudo"
    fi
}

# ----------------------------
# Polkit
# ----------------------------
POLKIT_ACTION="@management_interface@"

# Managing face models needs the polkit action of the Howdy management daemon.
# Ask for it once, the authorization is retained for a short time and covers the
# calls of howdy below. Does nothing for root, without polkit or as long as the
# action is not installed (Howdy is not installed yet, see the README of the project).
authorize() {
    [[ $EUID -eq 0 ]] && return 0
    command -v pkcheck >/dev/null || return 0
    pkaction --action-id "$POLKIT_ACTION" >/dev/null 2>&1 || return 0

    pkcheck --action-id "$POLKIT_ACTION" --process "$$" --allow-user-interaction || {
        echo "⚠️  Authorization denied, commands that need it will fail"
        return 1
    }
}

# Run a menu action in a subshell with "set -e". A failing command (also of
# howdy, for example if the polkit authorization is denied) or an error_exit ends
# only the action. The message stays on the screen, the menu is drawn below it.
KEEP_OUTPUT=0
run_action() {
    local rc
    # Not in a "||" list, bash ignores "set -e" there
    ( set -e; "$@" )
    rc=$?
    if [[ $rc -ne 0 ]]; then
        echo
        echo "⚠️  The action failed (exit code $rc)"
        KEEP_OUTPUT=1
    fi
    return 0
}

# ----------------------------
# Camera configuration
# ----------------------------
configure_camera() {
    require_root

    echo
    echo "Available cameras:"
    v4l2-ctl --list-devices || error_exit "v4l-utils not installed"

    echo
    read -rp "Enter camera device (example: /dev/video0): " DEVICE

    [[ ! -e "$DEVICE" ]] && error_exit "Device not found"

    set_config video device_path "$DEVICE"

    echo "✅ Camera set to $DEVICE"
    pause
}

# ----------------------------
# Menu actions
# ----------------------------
add_face() {
    echo
    echo "📸 Adding face model"
    echo "Look at the camera. Press Ctrl+C to cancel."
    pause
    howdy add
}

test_face() {
    echo
    echo "🧪 Testing face recognition"
    pause
    howdy test
}

list_models() {
    echo
    howdy list
    pause
}

remove_model() {
    howdy list
    echo
    read -rp "Enter model ID (or 'all'): " ID

    if [[ "$ID" == "all" ]]; then
        howdy clear
    else
        howdy remove "$ID"
    fi
    pause
}

toggle_howdy() {
    echo
    echo "1) Disable Howdy completely"
    echo "2) Enable Howdy"
    echo
    read -rp "Choose: " CHOICE

    case "$CHOICE" in
        1)
            require_root
            howdy disable 1
            ;;
        2)
            require_root
            howdy disable 0
            ;;
        *)
            echo "Invalid choice"
            ;;
    esac
    pause
}

config_menu() {
    echo
    echo "========== HOWDY CONFIG =========="
    echo "1) Set camera device"
    echo "E) Enable Howdy"
    echo "D) Disable Howdy"
    echo "T) Set timeout"
    echo "S) Set certainty (security level)"
    echo "C) Show current config"
    echo "B) Back"
    echo
    read -rp "Choose option: " CFG

    case "$CFG" in
        1)
            configure_camera
            ;;
        E|e)
            require_root
            set_config core disabled false
            echo "Howdy enabled"
            ;;
        D|d)
            require_root
            set_config core disabled true
            echo "Howdy disabled"
            ;;
        T|t)
            require_root
            read -rp "Enter timeout in seconds of the face authentication: " T
            if [[ ! "$T" =~ ^[0-9]+$ ]] || [[ "$T" -lt 1 ]]; then
                echo "Invalid timeout, enter a number of seconds"
            else
                set_config face_authentication timeout "$T"
            fi
            ;;
        S|s)
            require_root
            read -rp "Enter certainty in percent, 0 to 100 (higher = stricter, default 75): " C
            if [[ ! "$C" =~ ^[0-9]+(\.[0-9]+)?$ ]] || ! awk -v c="$C" 'BEGIN { exit !(c >= 0 && c <= 100) }'; then
                echo "Invalid certainty, enter a number from 0 to 100"
            else
                set_config face_authentication certainty "$C"
            fi
            ;;
        C|c)
            echo
            cat "$CONFIG_FILE"
            ;;
        B|b)
            return
            ;;
        *)
            echo "Invalid option"
            ;;
    esac
    pause
}

# set_config <section> <key> <value>: changes the option in its section only, several sections
# have a "timeout", and adds it to the section (or the section) if it is not there
set_config() {
    local section="$1" key="$2" value="$3" config="$CONFIG_FILE"

    if sed -n "/^\[$section\]/,/^\[/p" "$config" | grep -q "^$key *="; then
        sed -i "/^\[$section\]/,/^\[/ s|^$key *=.*|$key = $value|" "$config"
    elif grep -q "^\[$section\]" "$config"; then
        sed -i "/^\[$section\]/a $key = $value" "$config"
    else
        printf '\n[%s]\n%s = %s\n' "$section" "$key" "$value" >> "$config"
    fi
}



# ----------------------------
# Main Menu
# ----------------------------
main_menu() {
    if [[ $KEEP_OUTPUT -eq 1 ]]; then
        KEEP_OUTPUT=0
        echo
    else
        clear
    fi
    echo "======================================"
    echo "     HOWDY FACE AUTH MANAGER (BASH)"
    echo "======================================"
    echo
    echo "A) Add face model"
    echo "T) Test face recognition"
    echo "L) List face models"
    echo "D) Remove / clear models"
    echo "E) Enable / disable Howdy"
    echo "C) Configure Howdy"
    echo "Q) Exit"
    echo
    read -rp "Choose an option: " CHOICE

    case "$CHOICE" in
        A|a) run_action add_face ;;
        T|t) run_action test_face ;;
        L|l) run_action list_models ;;
        D|d) run_action remove_model ;;
        E|e) run_action toggle_howdy ;;
        C|c) run_action config_menu ;;
        Q|q) exit 0 ;;
        *) echo "Invalid choice"; pause ;;
    esac
}

# ----------------------------
# Entry point
# ----------------------------
# require_root
# authorize

while true; do
    main_menu
done

