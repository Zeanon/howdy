#!/bin/sh
set -e

# What was made while Howdy was in use: the face models, the snapshots, the cache and
# the downloaded models
if [ "$1" = purge ]; then
	root="${DPKG_ROOT:-}"
	rm -rf "$root/var/lib/howdy" "$root/var/log/howdy" "$root/var/cache/howdy"
	# Face models that older packages have left
	rm -rf "$root/etc/howdy/models" "$root/lib/security/howdy/models"
	rm -f "$root"/usr/share/howdy/dlib-models/*.dat "$root"/usr/share/howdy/openvino-models/*.xml \
		"$root"/usr/share/howdy/openvino-models/*.bin
fi

#DEBHELPER#

exit 0
