#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk

PACKAGE_DIR = debian/howdy

%:
	dh $@ --buildsystem=meson

# The face models are not encrypted: the key has to be sealed to the TPM first, which
# a package can not rely on. OpenVINO is not part of the distribution.
override_dh_auto_configure:
	dh_auto_configure -- \
		-Dpam_dir=/usr/lib/$(DEB_HOST_MULTIARCH)/security \
		-Dpython_path=/usr/bin/python3 \
		-Dmodels_key_file= \
		-Dopenvino=disabled

# The units and the sleep hook go to /lib, which is /usr/lib
execute_after_dh_auto_install:
	if [ -d $(PACKAGE_DIR)/lib ]; then \
		mkdir -p $(PACKAGE_DIR)/usr/lib && \
		cp -a $(PACKAGE_DIR)/lib/. $(PACKAGE_DIR)/usr/lib/ && \
		rm -rf $(PACKAGE_DIR)/lib; \
	fi

# The management daemon is started by D-Bus on the first call
override_dh_installsystemd:
	dh_installsystemd howdy-authentication.service
	dh_installsystemd --no-enable --no-start howdy-management.service

# The face models are only for root
execute_after_dh_fixperms:
	chmod 0700 $(PACKAGE_DIR)/var/lib/howdy $(PACKAGE_DIR)/var/cache/howdy/openvino
